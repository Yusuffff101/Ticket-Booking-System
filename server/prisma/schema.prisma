datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ORGANISER
  CUSTOMER
}

enum EventType {
  MOVIE
  CONCERT
}

enum SeatCategory {
  PREMIUM
  STANDARD
  ECONOMY
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  PENDING
  OFFERED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  eventsCreated   Event[]    @relation("OrganiserEvents")
  bookings        Booking[]  @relation("CustomerBookings")
  waitlistEntries Waitlist[] @relation("CustomerWaitlists")
  heldShowSeats   ShowSeat[] @relation("UserHeldSeats")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Venue {
  id         String   @id @default(uuid())
  name       String
  address    String
  city       String
  totalRows  Int      @map("total_rows")
  totalCols  Int      @map("total_cols")
  layoutJson Json     @map("layout_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  seats Seat[]
  shows Show[]

  @@map("venues")
}

model Seat {
  id         String       @id @default(uuid())
  venueId    String       @map("venue_id")
  row        String
  col        Int
  seatNumber String       @map("seat_number")
  category   SeatCategory @default(STANDARD)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // Relations
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  showSeats ShowSeat[]
  offers    Offer[]

  @@unique([venueId, row, col])
  @@index([venueId])
  @@map("seats")
}

model Event {
  id              String    @id @default(uuid())
  organiserId     String    @map("organiser_id")
  title           String
  description     String    @db.Text
  type            EventType
  durationMinutes Int       @map("duration_minutes")
  bannerUrl       String?   @map("banner_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  organiser User   @relation("OrganiserEvents", fields: [organiserId], references: [id], onDelete: Cascade)
  shows     Show[]

  @@index([organiserId])
  @@index([type])
  @@map("events")
}

model Show {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  venueId             String   @map("venue_id")
  startTime           DateTime @map("start_time")
  endTime             DateTime @map("end_time")
  categoryPricingJson Json     @map("category_pricing_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue           Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  showSeats       ShowSeat[]
  bookings        Booking[]
  waitlistEntries Waitlist[]

  @@index([eventId])
  @@index([venueId])
  @@index([startTime])
  @@map("shows")
}

model ShowSeat {
  id        String     @id @default(uuid())
  showId    String     @map("show_id")
  seatId    String     @map("seat_id")
  status    SeatStatus @default(AVAILABLE)
  price     Decimal    @db.Decimal(10, 2)
  version   Int        @default(1)

  // Hold State Management
  heldById  String?    @map("held_by_id")
  heldAt    DateTime?  @map("held_at")
  expiresAt DateTime?  @map("expires_at")

  // Associations
  bookingId String?    @map("booking_id")
  offerId   String?    @unique @map("offer_id")

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relations
  show      Show       @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat      Seat       @relation(fields: [seatId], references: [id], onDelete: Cascade)
  heldBy    User?      @relation("UserHeldSeats", fields: [heldById], references: [id], onDelete: SetNull)
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  offer     Offer?     @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([showId, seatId])
  @@index([showId, status])
  @@index([heldById])
  @@index([expiresAt])
  @@map("show_seats")
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique @map("booking_reference")
  customerId       String        @map("customer_id")
  showId           String        @map("show_id")
  totalAmount      Decimal       @map("total_amount") @db.Decimal(10, 2)
  status           BookingStatus @default(CONFIRMED)
  qrCodeUrl        String?       @map("qr_code_url")
  qrCodeData       String        @map("qr_code_data") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  customer  User       @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  show      Show       @relation(fields: [showId], references: [id], onDelete: Cascade)
  showSeats ShowSeat[]

  @@index([customerId])
  @@index([showId])
  @@index([bookingReference])
  @@map("bookings")
}

model Waitlist {
  id         String         @id @default(uuid())
  showId     String         @map("show_id")
  customerId String         @map("customer_id")
  category   SeatCategory
  status     WaitlistStatus @default(PENDING)
  joinedAt   DateTime       @default(now()) @map("joined_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  // Relations
  show     Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerWaitlists", fields: [customerId], references: [id], onDelete: Cascade)
  offers   Offer[]

  @@index([showId, category, status, joinedAt])
  @@index([customerId])
  @@map("waitlists")
}

model Offer {
  id             String      @id @default(uuid())
  waitlistId     String      @map("waitlist_id")
  seatId         String      @map("seat_id")
  token          String      @unique
  offerExpiresAt DateTime    @map("offer_expires_at")
  status         OfferStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  waitlist Waitlist  @relation(fields: [waitlistId], references: [id], onDelete: Cascade)
  seat     Seat      @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showSeat ShowSeat?

  @@index([waitlistId])
  @@index([token])
  @@index([offerExpiresAt, status])
  @@map("offers")
}
