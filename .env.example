# Server Environment
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/ticket_booking_db?schema=public"

# Redis Configuration (Locks, Cache, Sockets)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-key-production-ready-32-chars-min"
JWT_REFRESH_SECRET="super-secret-refresh-key-production-ready-32-chars-min"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Seat Hold & Waitlist Settings
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15

# Client URL (CORS)
CLIENT_URL="http://localhost:5173"

# Optional SMTP Settings (For real inbox delivery via Gmail / Resend / SendGrid / SES)
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-digit-app-password" # Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
